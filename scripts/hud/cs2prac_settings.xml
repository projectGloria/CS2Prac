<!--
  CS2Prac server settings window (L = css_pracmenu), driven by plugin/PracSkins/SettingsHud.cs. Not a layout of
  its own: build-hud.mjs puts this fragment into cs2prac_skins.xml at SETTINGS_WINDOW (same custom_hud_layout
  entity, so the two windows never fight over input capture) and fills PS_ROWS (counts = SetRows/RowChips).
  Icons: panels with class ps-ic + ic-<ui icon>/ie-<equipment icon> (CSS generated by build-hud.mjs).
  Same rules as the skin window: only Panel/Label/Button, no inline style, no ids on wrappers that don't need one.
-->
		<Panel id="ps_win" class="ps-win" hittest="true">
			<Panel class="pk-header" hittest="false">
				<Label id="ps_title" class="pk-title ps-title" text="{s:text}" hittest="false" />
				<Panel class="pk-tabs" hittest="false">
					<Button id="ps_tab_practice" class="pk-tab ps-tab"><Panel class="ps-ic ps-tab-ic ic-crosshair" hittest="false" /><Label class="pk-tab-text" text="Practice" hittest="false" /></Button>
					<Button id="ps_tab_server" class="pk-tab ps-tab"><Panel class="ps-ic ps-tab-ic ic-servers" hittest="false" /><Label class="pk-tab-text" text="Server" hittest="false" /></Button>
					<Button id="ps_tab_bots" class="pk-tab ps-tab"><Panel class="ps-ic ps-tab-ic ic-bot" hittest="false" /><Label class="pk-tab-text" text="Bots" hittest="false" /></Button>
					<Button id="ps_tab_sky" class="pk-tab ps-tab"><Panel class="ps-ic ps-tab-ic ic-picture" hittest="false" /><Label class="pk-tab-text" text="Sky" hittest="false" /></Button>
					<Button id="ps_tab_map" class="pk-tab ps-tab"><Panel class="ps-ic ps-tab-ic ic-map_onmap" hittest="false" /><Label class="pk-tab-text" text="Map" hittest="false" /></Button>
					<Button id="ps_tab_spots" class="pk-tab ps-tab"><Panel class="ps-ic ps-tab-ic ic-fast" hittest="false" /><Label class="pk-tab-text" text="Spots" hittest="false" /></Button>
					<Button id="ps_tab_nades" class="pk-tab ps-tab"><Panel class="ps-ic ps-tab-ic ic-chatwheel_grenade" hittest="false" /><Label class="pk-tab-text" text="Nades" hittest="false" /></Button>
				</Panel>
				<Button id="ps_close" class="pk-close"><Panel class="ps-ic ps-close-ic ic-cancel" hittest="false" /></Button>
			</Panel>

			<Panel class="ps-list" hittest="true">
<!--PS_ROWS-->
			</Panel>

			<Panel class="pk-footer" hittest="false">
				<Panel class="ps-ic ps-foot-ic ic-save" hittest="false" />
				<Button id="ps_scope_global" class="pk-chip has-ic"><Panel class="ps-ic ps-chip-ic ic-globe" hittest="false" /><Label class="pk-chip-text" text="Every map" hittest="false" /></Button>
				<Button id="ps_scope_map" class="pk-chip has-ic"><Panel class="ps-ic ps-chip-ic ic-map_onmap" hittest="false" /><Label class="pk-chip-text" text="This map" hittest="false" /></Button>
				<Button id="ps_reset" class="pk-chip has-ic ps-reset"><Panel class="ps-ic ps-chip-ic ic-undo" hittest="false" /><Label class="pk-chip-text" text="Reset" hittest="false" /></Button>
				<Label id="ps_status" class="pk-status" text="{s:text}" hittest="false" />
			</Panel>
		</Panel>
