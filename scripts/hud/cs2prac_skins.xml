<!--
  CS2Prac skin window (custom_hud_layout). Driven by plugin/PracSkins/Hud.cs: texts through {s:text} dialog
  variables, state and images through classes set per player. Built by scripts/hud/build-hud.mjs (it also writes
  the tile rows/tiles below from TEMPLATE markers, so the counts match Hud.cs).

  Rules learned elsewhere (cs2-ui-kit GOTCHAS): the root panel has no id; only Panel, Label, Image and Button;
  no inline style attributes; images only as CSS backgrounds.
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/cs2prac_skins.vcss_c" />
	</styles>

	<Panel class="pk-screen" hittest="false">
		<!-- Must stay a Panel: with a full-screen Button here CS2 rejected the whole layout (nothing showed). -->
		<Panel id="pk_dim" class="pk-dim" hittest="true" />

		<Panel id="pk_win" class="pk-win" hittest="true">

			<Panel class="pk-header" hittest="false">
				<Label id="pk_title" class="pk-title" text="{s:text}" hittest="false" />
				<Panel class="pk-tabs" hittest="false">
					<Button id="pk_tab_weapons" class="pk-tab"><Label class="pk-tab-text" text="Weapons" hittest="false" /></Button>
					<Button id="pk_tab_knives" class="pk-tab"><Label class="pk-tab-text" text="Knives" hittest="false" /></Button>
					<Button id="pk_tab_gloves" class="pk-tab"><Label class="pk-tab-text" text="Gloves" hittest="false" /></Button>
					<Button id="pk_tab_agents" class="pk-tab"><Label class="pk-tab-text" text="Agents" hittest="false" /></Button>
					<Button id="pk_tab_pins" class="pk-tab"><Label class="pk-tab-text" text="Pins" hittest="false" /></Button>
					<Button id="pk_tab_music" class="pk-tab"><Label class="pk-tab-text" text="Music" hittest="false" /></Button>
				</Panel>
				<Button id="pk_close" class="pk-close"><Label class="pk-close-text" text="&#10005;" hittest="false" /></Button>
			</Panel>

			<Panel class="pk-body" hittest="false">
				<!-- Scrolls with the mouse wheel; enough rows for every gun, so no paging. -->
				<Panel id="pk_side" class="pk-side" hittest="true">
<!--SIDE_ROWS-->
				</Panel>

				<Panel class="pk-main" hittest="false">
					<Label id="pk_heading" class="pk-heading" text="{s:text}" hittest="false" />
					<!-- Agents tab only: view toggle; in third person also pose and camera buttons (AgentView.cs). -->
					<Panel id="pk_agentbar" class="pk-agentbar" hittest="false">
						<Panel class="pk-barrow" hittest="false">
							<Label class="pk-barlabel" text="View" hittest="false" />
							<Button id="pk_view_first" class="pk-chip"><Label class="pk-chip-text" text="First person" hittest="false" /></Button>
							<Button id="pk_view_third" class="pk-chip"><Label class="pk-chip-text" text="Third person" hittest="false" /></Button>
							<Label id="pk_hint" class="pk-hint" text="{s:text}" hittest="false" />
						</Panel>
						<Panel id="pk_tp" class="pk-tp" hittest="false">
							<Panel class="pk-barrow" hittest="false">
								<Label class="pk-barlabel" text="Pose" hittest="false" />
								<Button id="pk_pose_held" class="pk-chip"><Label class="pk-chip-text" text="Yours" hittest="false" /></Button>
								<Button id="pk_pose_knife" class="pk-chip"><Label class="pk-chip-text" text="Knife" hittest="false" /></Button>
								<Button id="pk_pose_pistol" class="pk-chip"><Label class="pk-chip-text" text="Pistol" hittest="false" /></Button>
								<Button id="pk_pose_smg" class="pk-chip"><Label class="pk-chip-text" text="SMG" hittest="false" /></Button>
								<Button id="pk_pose_rifle" class="pk-chip"><Label class="pk-chip-text" text="Rifle" hittest="false" /></Button>
								<Button id="pk_pose_shotgun" class="pk-chip"><Label class="pk-chip-text" text="Shotgun" hittest="false" /></Button>
								<Button id="pk_pose_sniper" class="pk-chip"><Label class="pk-chip-text" text="Sniper" hittest="false" /></Button>
								<Button id="pk_pose_mg" class="pk-chip"><Label class="pk-chip-text" text="MG" hittest="false" /></Button>
								<Button id="pk_pose_grenade" class="pk-chip"><Label class="pk-chip-text" text="Grenade" hittest="false" /></Button>
								<Button id="pk_pose_c4" class="pk-chip"><Label class="pk-chip-text" text="C4" hittest="false" /></Button>
								<Button id="pk_pose_zeus" class="pk-chip"><Label class="pk-chip-text" text="Zeus" hittest="false" /></Button>
							</Panel>
							<Panel class="pk-barrow" hittest="false">
								<Label class="pk-barlabel" text="Stance" hittest="false" />
								<Button id="pk_stance_stand" class="pk-chip"><Label class="pk-chip-text" text="Stand" hittest="false" /></Button>
								<Button id="pk_stance_crouch" class="pk-chip"><Label class="pk-chip-text" text="Crouch" hittest="false" /></Button>
							</Panel>
							<Panel class="pk-barrow" hittest="false">
								<Label class="pk-barlabel" text="Camera" hittest="false" />
								<Button id="pk_cam_left" class="pk-chip"><Label class="pk-chip-text" text="&#9664; Turn" hittest="false" /></Button>
								<Button id="pk_cam_right" class="pk-chip"><Label class="pk-chip-text" text="Turn &#9654;" hittest="false" /></Button>
								<Button id="pk_cam_in" class="pk-chip"><Label class="pk-chip-text" text="Zoom +" hittest="false" /></Button>
								<Button id="pk_cam_out" class="pk-chip"><Label class="pk-chip-text" text="Zoom -" hittest="false" /></Button>
								<Button id="pk_cam_up" class="pk-chip"><Label class="pk-chip-text" text="&#9650;" hittest="false" /></Button>
								<Button id="pk_cam_down" class="pk-chip"><Label class="pk-chip-text" text="&#9660;" hittest="false" /></Button>
								<Button id="pk_cam_reset" class="pk-chip"><Label class="pk-chip-text" text="Reset" hittest="false" /></Button>
								<Button id="pk_cam_mouse" class="pk-chip"><Label class="pk-chip-text" text="Mouse look" hittest="false" /></Button>
							</Panel>
						</Panel>
					</Panel>
					<Label id="pk_empty" class="pk-empty" text="{s:text}" hittest="false" />
					<Panel class="pk-grid" hittest="true">
<!--GRID_ROWS-->
					</Panel>
				</Panel>
			</Panel>

			<Panel class="pk-footer" hittest="false">
				<Button id="pk_prev" class="pk-pager"><Label class="pk-pager-text" text="&#9664;" hittest="false" /></Button>
				<Label id="pk_page" class="pk-page" text="{s:text}" hittest="false" />
				<Button id="pk_next" class="pk-pager"><Label class="pk-pager-text" text="&#9654;" hittest="false" /></Button>
				<Label id="pk_status" class="pk-status" text="{s:text}" hittest="false" />
				<Panel id="pk_wears" class="pk-wears" hittest="false">
					<Button id="pk_wear_0" class="pk-wear"><Label class="pk-wear-text" text="FN" hittest="false" /></Button>
					<Button id="pk_wear_1" class="pk-wear"><Label class="pk-wear-text" text="MW" hittest="false" /></Button>
					<Button id="pk_wear_2" class="pk-wear"><Label class="pk-wear-text" text="FT" hittest="false" /></Button>
					<Button id="pk_wear_3" class="pk-wear"><Label class="pk-wear-text" text="WW" hittest="false" /></Button>
					<Button id="pk_wear_4" class="pk-wear"><Label class="pk-wear-text" text="BS" hittest="false" /></Button>
					<Button id="pk_st" class="pk-wear pk-st"><Label class="pk-wear-text" text="StatTrak" hittest="false" /></Button>
				</Panel>
			</Panel>

		</Panel>

<!--SETTINGS_WINDOW-->
	</Panel>
</root>
