{
  "name": "cs2prac",
  "version": "1.6.0",
  "description": "Local CS2 practice server manager",
  "author": "projectGloria",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:plugin": "dotnet build plugin/PracSkins -c Release -o resources/plugin/PracSkins",
    "dist": "npm run build:bundle && npm run build && electron-builder --win --publish never",
    "release": "npm run build:bundle && npm run build && electron-builder --win --publish always",
    "build:bundle": "node scripts/bundle.mjs",
    "build:hud": "node scripts/hud/build-hud.mjs",
    "build:modeltool": "node scripts/build-modeltool.mjs",
    "build:weaponstats": "node scripts/items/build-weapon-stats.mjs",
    "build:site": "node scripts/site/build-site.mjs site",
    "build:docs": "node scripts/site/build-site.mjs docs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "three": "^0.180.0"
  },
  "allowScripts": {
    "electron-winstaller": false,
    "electron@45.3.2": true
  },
  "build": {
    "appId": "com.projectgloria.cs2prac",
    "productName": "CS2Prac",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/plugin",
        "to": "plugin"
      },
      {
        "from": "resources/bundle",
        "to": "bundle"
      },
      {
        "from": "resources/hud",
        "to": "hud"
      },
      {
        "from": "resources/modeltool",
        "to": "modeltool"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/CS2Prac.ico"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "assets/CS2Prac.ico",
      "uninstallerIcon": "assets/CS2Prac.ico",
      "installerHeaderIcon": "assets/CS2Prac.ico",
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "CS2Prac-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "shortcutName": "CS2Prac"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "projectGloria",
        "repo": "CS2Prac"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/projectGloria/CS2Prac.git"
  }
}
